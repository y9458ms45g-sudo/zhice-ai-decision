# ==================== 日志配置 ====================
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ==================== 火山引擎方舟大模型（AI建议功能）====================
# 申请地址：https://console.volcengine.com/ark
# 创建推理接入点后，把API Key和接入点ID填到下面
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_MODEL=your_endpoint_id_here

# ==================== 数据库（由平台提供，本地开发可留空）====================
# DATABASE_URL=postgresql://user:password@localhost:5432/zhice
